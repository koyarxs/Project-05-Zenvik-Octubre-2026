POSTGRES_DB=zenvik_db
POSTGRES_USER=zenvik_app
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
# Local Docker has no TLS; use verify-full + a trusted CA for remote production.
POSTGRES_SSLMODE=prefer

DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Set True only for an HTTPS deployment. Keep DEBUG=False in production.
DJANGO_PRODUCTION=False
APP_ENVIRONMENT=development
DJANGO_READ_DOTENV=True
DJANGO_BEHIND_PROXY=False
# When a private deployment proxy is used, list its actual peer CIDRs explicitly.
TRUSTED_PROXY_CIDRS=
# Optional injected files: DJANGO_SECRET_KEY_FILE, POSTGRES_PASSWORD_FILE.
# Secure deployments disable dotenv and require POSTGRES_SSLMODE=verify-full.
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=0
CSRF_TRUSTED_ORIGINS=
# If omitted, these default to False in production and True locally.
# DJANGO_ADMIN_ENABLED=False
# PUBLIC_REGISTRATION_ENABLED=False
# Opcional en desarrollo. Activar tras configurar y probar el envío SMTP.
# REGISTRATION_VERIFY_EMAIL=True
# REGISTRATION_WEB_ORIGIN=http://127.0.0.1:3000
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=

# Cloudflare Turnstile. Local example is off: set True with real keys for production.
# Create a Managed widget in your Cloudflare account before enabling.
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Billing: sandbox only. Production payments are deliberately unsupported.
# Use separate sandbox credentials; never add real keys to this tracked template.
BILLING_PAYMENT_MODE=disabled
FLOW_SANDBOX_API_KEY=
FLOW_SANDBOX_SECRET_KEY=
FLOW_SANDBOX_CONFIRMATION_URL=
FLOW_SANDBOX_RETURN_URL=
