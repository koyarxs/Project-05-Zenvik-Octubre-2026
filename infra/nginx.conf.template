# Prepared ingress example, not an active service. Supply PUBLIC_HOST + real TLS files.
server {
    listen 8443 ssl;
    server_name ${PUBLIC_HOST};
    ssl_certificate /run/secrets/tls.crt;
    ssl_certificate_key /run/secrets/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != "${PUBLIC_HOST}") { return 444; }
    client_max_body_size 64k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    access_log off; # Use aggregate edge metrics, not URL/query/cookie/IP logs.
    # The deployment collector must redact request context before retention/export.
    # This template alone does not sanitize native ingress error messages.
    error_log /dev/stderr warn;
    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_buffering off;
    }
}
