# Prepared only. No real hostnames, credentials, billing activation or deployment.
APP_ENVIRONMENT=production
COMPOSE_PROJECT_NAME=zenvik-production
BILLING_PAYMENT_MODE=disabled
PUBLIC_HOST=app.example.invalid
TRUSTED_PROXY_CIDRS=192.0.2.20/32
POSTGRES_HOST=production-database.private.example.invalid
POSTGRES_PORT=5432
POSTGRES_DB=zenvik_production
POSTGRES_RUNTIME_USER=zenvik_production_runtime
POSTGRES_MIGRATION_USER=zenvik_production_migrator
POSTGRES_OWNER_ROLE=zenvik_production_owner
DJANGO_KEY_FILE=/secure/production/django-key
RUNTIME_DB_PASSWORD_FILE=/secure/production/runtime-password
MIGRATION_DB_PASSWORD_FILE=/secure/production/migrator-password
DATABASE_CA_FILE=/secure/production/database-ca.pem
API_IMAGE=zenvik-api:stage16
WEB_IMAGE=zenvik-web:stage16
