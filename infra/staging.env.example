# No credentials. Copy to a protected untracked location and complete explicitly.
APP_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=zenvik-staging
BILLING_PAYMENT_MODE=disabled
PUBLIC_HOST=staging.example.invalid
TRUSTED_PROXY_CIDRS=192.0.2.10/32
POSTGRES_HOST=database.private.example.invalid
POSTGRES_PORT=5432
POSTGRES_DB=zenvik_staging
POSTGRES_RUNTIME_USER=zenvik_staging_runtime
POSTGRES_MIGRATION_USER=zenvik_staging_migrator
POSTGRES_OWNER_ROLE=zenvik_staging_owner
DJANGO_KEY_FILE=/secure/staging/django-key
RUNTIME_DB_PASSWORD_FILE=/secure/staging/runtime-password
MIGRATION_DB_PASSWORD_FILE=/secure/staging/migrator-password
DATABASE_CA_FILE=/secure/staging/database-ca.pem
API_IMAGE=zenvik-api:stage16
WEB_IMAGE=zenvik-web:stage16
