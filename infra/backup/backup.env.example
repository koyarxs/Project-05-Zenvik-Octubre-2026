# Prepared only; do not source this placeholder environment as an active job.
BACKUP_ENABLED=false
BACKUP_ENVIRONMENT=production
PGHOST=private-database.example.invalid
PGPORT=5432
PGDATABASE=zenvik_production
PGUSER=zenvik_backup
PGPASSFILE=/etc/zenvik/backup.pgpass
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/zenvik/database-ca.pem
BACKUP_KEY_FILE=/etc/zenvik/backup-aes-key
BACKUP_OUTPUT_ROOT=/var/lib/zenvik-backup
BACKUP_S3_PREFIX=s3://replace-with-private-bucket/zenvik/production/
BACKUP_KMS_KEY_ID=replace-with-approved-kms-key-id
